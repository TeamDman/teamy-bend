+// A completed proper field subtree can be retained as immutable output instead
+// of retaining its compiler rows while processing the next field. The marker is
+// identified only by Rc identity, never by its name or binder ID, and must be
+// removed before returning a parsed term. It consumes no fresh binder ID.
+struct FieldBoundary {
+    next_field: usize,
+    hole: TermRef,
+    next: Option<MatchState>,
+    deferred_error: Option<FlattenError>,
+}
+
+impl FieldBoundary {
+    fn new(next_field: usize) -> Self {
+        Self {
+            next_field,
+            hole: term(Term::Var { name: "_field_continuation".into(), id: usize::MAX }),
+            next: None,
+            deferred_error: None,
+        }
+    }
+}
+
+fn closed_pattern(pattern: &Pattern, depth: usize) -> bool {
+    if depth >= 64 { return false; }
+    match pattern {
+        Pattern::Variable(_) => false,
+        Pattern::Constructor(_, fields, _) => fields.iter().all(|field| closed_pattern(field, depth + 1)),
+    }
+}
+
+fn terminal_rows(rows: &[Row]) -> bool {
+    rows.iter().all(|row| {
+        matches!(row.body, Body::Reply(_))
+            && row.patterns.iter().all(|p| matches!(p, Pattern::Variable(_)))
+    })
+}
+
+fn fragment_eligible(rows: &[Row]) -> bool {
+    let mut selected = None;
+    for row in rows {
+        if row.patterns.iter().any(|p| matches!(p, Pattern::Constructor(..))) {
+            if selected.replace(row).is_some() { return false; }
+        } else if !matches!(row.body, Body::Reply(_)) {
+            return false;
+        }
+    }
+    selected.is_some_and(|row| {
+        matches!(row.patterns.first(), Some(Pattern::Constructor(_, fields, _)) if !fields.is_empty())
+            && closed_pattern(&row.patterns[0], 0)
+    })
+}
+
+#[expect(clippy::too_many_arguments, reason = "Fallbacks retain the match compiler's explicit traversal state")]
+fn flatten_fallback(
+    scrutinees: &[SurfaceTerm], rows: &[Row], vars: &[Variable],
+    fresh: &mut usize, display_fresh: &mut usize, depth: usize,
+    origins: Option<&TermOrigins>, boundary: Option<&mut FieldBoundary>,
+) -> Result<SurfaceTerm, FlattenError> {
+    let Some(boundary) = boundary else {
+        return flatten_match(scrutinees, rows, vars, fresh, display_fresh, depth, origins, None);
+    };
+    if !terminal_rows(rows) {
+        return Err("field fragment requires terminal fallback rows".into());
+    }
+    if boundary.deferred_error.is_some() {
+        return Ok(SurfaceTerm::new(term(Term::Efq), origins));
+    }
+    let before = (*fresh, *display_fresh);
+    let result = flatten_match(scrutinees, rows, vars, fresh, display_fresh, depth, origins, None);
+    debug_assert_eq!(before, (*fresh, *display_fresh));
+    match result {
+        Err(error) if boundary.next.is_some() => {
+            // The original traversal reports a successful arm's errors before
+            // its fallback's errors. Finish the suffix before returning this.
+            boundary.deferred_error = Some(error);
+            Ok(SurfaceTerm::new(term(Term::Efq), origins))
+        }
+        result => result,
+    }
+}
+
+fn graft_field(
+    prefix: SurfaceTerm, hole: &TermRef, mut suffix: SurfaceTerm,
+    origins: Option<&TermOrigins>,
+) -> Result<SurfaceTerm, FlattenError> {
+    // Only the successful-arm path contains the private marker. Other subtrees
+    // remain pointer-identical, including any shared macro references.
+    let mut path = Vec::new();
+    let mut cursor = &prefix.value;
+    while !Rc::ptr_eq(cursor, hole) {
+        path.push(Rc::clone(cursor));
+        cursor = match cursor.as_ref() {
+            Term::Mat { arm, .. } => arm,
+            Term::Lam { body, .. } => body,
+            _ => return Err("field fragment lost its continuation".into()),
+        };
+    }
+    for parent in path.into_iter().rev() {
+        match parent.as_ref() {
+            Term::Mat { constructor, fallback, .. } => {
+                let mut fallback_value = SurfaceTerm::new(Rc::clone(fallback), origins);
+                if let Some(origins) = origins {
+                    if let Some(source) = origins.child_source(&parent, 1, fallback) {
+                        fallback_value.origin = source;
+                    }
+                    fallback_value.explicit_source = origins.occurrence_source(&parent, 1);
+                }
+                suffix = SurfaceTerm::matched(
+                    constructor.clone(), suffix, fallback_value,
+                    origins.and_then(|o| o.match_site(&parent)),
+                    origins.and_then(|o| o.constructor_source(&parent)), origins,
+                );
+            }
+            Term::Lam { name, id, .. } => {
+                suffix = suffix.lambda(&Variable { name: name.clone(), id: *id }, origins);
+            }
+            _ => unreachable!("only matched-arm and binder parents were recorded"),
+        }
+    }
+    Ok(suffix)
+}
