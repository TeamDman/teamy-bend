+
+#[cfg(test)]
+mod pattern_trace {
+    use super::*;
+    use std::cell::RefCell;
+    #[derive(Default)]
+    struct State { enabled: bool, constructors: Vec<(String, usize, usize)>, nullary: usize, peak_states: usize }
+    thread_local! { static STATE: RefCell<State> = RefCell::new(State::default()); }
+    fn nodes(p: &Pattern) -> usize { match p { Pattern::Variable(_) => 1, Pattern::Constructor(_, xs, _) => 1 + xs.iter().map(nodes).sum::<usize>() } }
+    pub struct Constructor;
+    impl Constructor {
+        pub fn new(name: &str, positive: &[Row], negative: &[Row]) -> Self {
+            STATE.with(|s| { let mut s=s.borrow_mut(); if s.enabled { s.constructors.push((name.into(), positive.len()+negative.len(), positive.iter().chain(negative).flat_map(|r| &r.patterns).map(nodes).sum())); s.peak_states=s.peak_states.max(s.constructors.len()+s.nullary); } }); Self
+        }
+    }
+    impl Drop for Constructor { fn drop(&mut self) { STATE.with(|s| { let mut s=s.borrow_mut(); if s.enabled { s.constructors.pop(); } }); } }
+    pub struct Pending(usize);
+    impl Pending {
+        pub fn new() -> Self { Self(0) }
+        pub fn set(&mut self, n: usize) { STATE.with(|s| { let mut s=s.borrow_mut(); if s.enabled { s.nullary=s.nullary-self.0+n; s.peak_states=s.peak_states.max(s.constructors.len()+s.nullary); } }); self.0=n; }
+    }
+    impl Drop for Pending { fn drop(&mut self) { STATE.with(|s| { let mut s=s.borrow_mut(); if s.enabled { s.nullary-=self.0; } }); } }
+    pub fn failure(depth: usize, pending: usize) { STATE.with(|s| { let s=s.borrow(); if s.enabled { eprintln!("TRACE failure depth={depth} local_pending={pending} active_constructor_frames={} nullary_states={} peak_states={} retained_rows={} owned_pattern_nodes={} path={:?}",s.constructors.len(),s.nullary,s.peak_states,s.constructors.iter().map(|x| x.1).sum::<usize>(),s.constructors.iter().map(|x| x.2).sum::<usize>(),s.constructors.iter().map(|x| &x.0).collect::<Vec<_>>()); } }); }
+    #[test]
+    fn bounded_literal_probe() {
+        let file=std::env::var("TEAMY_PATTERN_TRACE_FILE").unwrap();
+        STATE.with(|s| s.borrow_mut().enabled=true);
+        let result=crate::syntax::load(file);
+        STATE.with(|s| { let mut s=s.borrow_mut(); eprintln!("TRACE outcome={} peak_states={}", if result.is_ok() {"loaded"} else {"refused"},s.peak_states); s.enabled=false; });
+        if let Err(e)=result { eprintln!("TRACE error={}",e.message); }
+    }
+}
