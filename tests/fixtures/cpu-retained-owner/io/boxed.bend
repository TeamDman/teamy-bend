import Base
def append(a: String, b: String) -> String: String.append(a, b)
def value() -> String:
  left right = append append
  +text = String.append("ow", "ner")
  a b = left(text, text) right(text, text)
  String.append(a, String.append(b, text))

def main() -> IO(Unit): IO.print(value())
